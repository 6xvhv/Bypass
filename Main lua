section(P, "100 GOAL CHALLENGE");
do
	local hc = require(RS:WaitForChild("EgoShared")).hundredChallenge;
	local FINISH = hc.minTime + 0.6;
	local PACE = FINISH / hc.goals;
	local run = {t0=nil,lastSeen=0,fired=setmetatable({}, {__mode="k"})};
	local function hit(btn)
		if firesignal then
			pcall(firesignal, btn.MouseButton1Down);
		elseif getconnections then
			for _, c in ipairs(getconnections(btn.MouseButton1Down)) do
				pcall(function()
					c:Fire();
				end);
			end
		end
	end
	local function scan(frame)
		local FlatIdent_1B638 = 0;
		local goals;
		local target;
		while true do
			if (FlatIdent_1B638 == 0) then
				goals, target = nil, nil;
				for _, d in ipairs(frame:GetDescendants()) do
					if d:IsA("TextLabel") then
						local FlatIdent_1454F = 0;
						local n;
						while true do
							if (FlatIdent_1454F == 0) then
								n = tonumber(string.match(d.Text, "^GOALS: (%d+)/"));
								if (n and (not goals or (n > goals))) then
									goals = n;
								end
								break;
							end
						end
					elseif (d:IsA("TextButton") and (d.Text == "") and not run.fired[d]) then
						local FlatIdent_8E29D = 0;
						local p;
						local c;
						while true do
							if (1 == FlatIdent_8E29D) then
								if (c and (c.CornerRadius.Offset == 999) and p:FindFirstChildOfClass("UIStroke")) then
									target = d;
								end
								break;
							end
							if (FlatIdent_8E29D == 0) then
								p = d.Parent;
								c = p and p:FindFirstChildOfClass("UICorner");
								FlatIdent_8E29D = 1;
							end
						end
					end
				end
				FlatIdent_1B638 = 1;
			end
			if (FlatIdent_1B638 == 1) then
				return goals, target;
			end
		end
	end
	toggle(P, "Auto 100 Goals", "autoHundred");
	note(P, ("Open the challenge and press I'M READY; the targets get hit for you. Goals are paced to finish in ~%.1fs, since the server rejects anything under %ds."):format(FINISH, hc.minTime));
	track(RunService.Heartbeat:Connect(function()
		local FlatIdent_11AA1 = 0;
		local pg;
		local frame;
		local goals;
		local target;
		local now;
		while true do
			if (FlatIdent_11AA1 == 2) then
				if not target then
					local FlatIdent_270C = 0;
					while true do
						if (FlatIdent_270C == 0) then
							if (run.t0 and ((now - run.lastSeen) > 3)) then
								run.t0 = nil;
							end
							return;
						end
					end
				end
				run.lastSeen = now;
				goals = goals or 0;
				FlatIdent_11AA1 = 3;
			end
			if (FlatIdent_11AA1 == 1) then
				if not frame then
					local FlatIdent_7A6E5 = 0;
					while true do
						if (FlatIdent_7A6E5 == 0) then
							run.t0 = nil;
							return;
						end
					end
				end
				goals, target = scan(frame);
				now = os.clock();
				FlatIdent_11AA1 = 2;
			end
			if (FlatIdent_11AA1 == 0) then
				if not cfg.autoHundred then
					return;
				end
				pg = LocalPlayer:FindFirstChildOfClass("PlayerGui");
				frame = pg and pg:FindFirstChild("GoalRushFrame", true);
				FlatIdent_11AA1 = 1;
			end
			if (3 == FlatIdent_11AA1) then
				if (not run.t0 or ((goals == 0) and ((now - run.t0) > FINISH))) then
					run.t0 = now;
				end
				if (now >= (run.t0 + ((goals + 1) * PACE))) then
					local FlatIdent_5CC3B = 0;
					while true do
						if (0 == FlatIdent_5CC3B) then
							run.fired[target] = true;
							hit(target);
							break;
						end
					end
				end
				break;
			end
		end
	end));
end
