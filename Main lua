local function takeBall()
	local sim = state.sim;
	if (not sim or sim.outcome or ((os.clock() - state.lastStep) > 1)) then
		return false, "no live match";
	end
	local me = controlledOf(sim);
	if not me then
		return false, "no controlled player";
	end
	sim.physics:kick(sim.ball, Vector3.new(0, 0, 0), Vector3.new(0, 0, 0));
	sim.ball.position = me.body.position + (me.body.facing * 1.2) + Vector3.new(0, sim.physics.radius, 0);
	sim.ball.spin = Vector3.new(0, 0, 0);
	sim.pass = nil;
	sim:takePossession(me);
	me.ai.immuneUntil = math.max(me.ai.immuneUntil or 0, sim.clock + 0.8);
	return true;
